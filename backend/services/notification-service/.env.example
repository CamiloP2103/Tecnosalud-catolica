# Copia este archivo como .env y ajusta los valores. Nunca subas el .env a git.
PORT=3005

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Usa una contraseña de aplicación de Gmail, no la contraseña de la cuenta
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Tecnosalud Católica <correo@ejemplo.com>"

# Clave compartida con auth-service, registro-service y farmacias-service (debe ser la misma en todos).
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTIFICATION_API_KEY=

# Base de datos del historial de correos (db_notificaciones). Si no está disponible, los correos se
# envían igual y solo se pierde el registro.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_notificaciones
DB_SSL=false
