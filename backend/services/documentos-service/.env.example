# Copia este archivo como .env y ajusta los valores. Nunca subas el .env a git.
PORT=3006
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_documentos
DB_SSL=false

# Obligatorio: el MISMO valor de JWT_SECRET del auth-service (para validar la sesión del usuario)
JWT_SECRET=

# Obligatorio: clave AES-256 de 32 bytes en hexadecimal (64 caracteres) para cifrar los archivos.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si la pierdes o la cambias, los archivos ya guardados NO se podrán descifrar.
DOCUMENTOS_ENCRYPTION_KEY=

# Carpeta donde se guardan los archivos cifrados (relativa a la carpeta del servicio)
DOCUMENTOS_STORAGE_DIR=./storage
