# Copia este archivo como .env y ajusta los valores. Nunca subas el .env a git.
PORT=3004
FRONTEND_URL=http://localhost:5173
NOTIFICATION_SERVICE_URL=http://localhost:3005

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_farmacias
DB_SSL=false

# Obligatorio: el MISMO valor de JWT_SECRET del auth-service (para validar la sesión del usuario)
JWT_SECRET=

# Debe ser igual a NOTIFICATION_API_KEY del notification-service
NOTIFICATION_API_KEY=

# Reabastecimiento semanal del inventario (solo los lunes, una vez por semana)
REABASTECIMIENTO_AUTOMATICO=true
REABASTECIMIENTO_OBJETIVO=60
